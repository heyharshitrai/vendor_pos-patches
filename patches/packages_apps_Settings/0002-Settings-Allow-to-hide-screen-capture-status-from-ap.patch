From a0da5d30f5f89ef3a83ac749fedb12b2ea385c75 Mon Sep 17 00:00:00 2001
From: someone5678 <someone5678@users.noreply.github.com>
Date: Tue, 21 May 2024 10:13:17 -0400
Subject: [PATCH 2/4] Settings: Allow to hide screen capture status from apps
 [2/2]

* Allow to hide screen capture detection from privacy invasive apps

Change-Id: I82989e03b5e181a8a3fcf797a27a70bfa5fd06d1
Signed-off-by: someone5678 <someone5678@users.noreply.github.com>
---
 res/values/custom_strings.xml              | 4 ++++
 res/xml/more_security_privacy_settings.xml | 6 ++++++
 2 files changed, 10 insertions(+)

diff --git a/res/values/custom_strings.xml b/res/values/custom_strings.xml
index 36c05c1b6b9..fd2ed3be0ea 100644
--- a/res/values/custom_strings.xml
+++ b/res/values/custom_strings.xml
@@ -407,6 +407,10 @@
     <string name="menu_show_overlay">Show overlay</string>
     <string name="menu_hide_overlay">Hide overlay</string>
 
+    <!-- Hide screen capture status -->
+    <string name="hide_screen_capture_status_title">Hide screen capture status</string>
+    <string name="hide_screen_capture_status_summary">Hide screen capture and screen record status from all applications. Can be convenient in some cases but may lead to privacy leaks. Need to restart applications for the change to take effect.</string>
+
     <!-- Expressive QR -->
     <string name="wifi_qr_code_animation_control">pause the animation</string>
 
diff --git a/res/xml/more_security_privacy_settings.xml b/res/xml/more_security_privacy_settings.xml
index d4bc6dc100b..1da85f060a3 100644
--- a/res/xml/more_security_privacy_settings.xml
+++ b/res/xml/more_security_privacy_settings.xml
@@ -250,6 +250,12 @@
         android:summary="@string/hide_applist_summary"
         android:fragment="com.android.settings.custom.privacy.HideAppListSettings" />
 
+    <com.android.settings.custom.preference.GlobalSettingSwitchPreference
+        android:key="hide_screen_capture_status"
+        android:title="@string/hide_screen_capture_status_title"
+        android:summary="@string/hide_screen_capture_status_summary"
+        android:defaultValue="false"/>
+
     <Preference
         android:order="310"
         android:key="binary_transparency_settings"
